<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Home</title>

<style>
  body {
    margin: 0;
    font-family: 'Segoe UI', sans-serif;
    background: #f5f7fa;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
  }

  .container {
    text-align: center;
    animation: fadeIn 1s ease;
  }

  h1 {
    color: #333;
    margin-bottom: 20px;
  }

  .btn {
    padding: 12px 25px;
    border: none;
    background: #4a90e2;
    color: white;
    font-size: 16px;
    border-radius: 25px;
    cursor: pointer;
    transition: 0.3s;
  }

  .btn:hover {
    background: #357abd;
  }

  /* Popup background */
  .popup {
    position: fixed;
    inset: 0;
    background: rgba(0,0,0,0.4);
    display: none;
    justify-content: center;
    align-items: center;
    animation: fadeIn 0.3s ease;
  }

  /* Popup box animation */
  .popup-box {
    background: white;
    padding: 30px;
    border-radius: 12px;
    text-align: center;
    width: 280px;
    box-shadow: 0 10px 25px rgba(0,0,0,0.2);
    animation: slideUp 0.4s ease;
  }

  .popup-box h3 {
    margin-bottom: 20px;
    color: #444;
  }

  .popup-box button {
    margin: 5px;
    padding: 10px 18px;
    border: none;
    border-radius: 20px;
    cursor: pointer;
  }

  .login-btn {
    background: #4a90e2;
    color: white;
  }

  .cancel-btn {
    background: #ddd;
  }

  /* Animations */
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes slideUp {
    from {
      transform: translateY(40px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }
</style>
</head>

<body>

<div class="container">
  <h1>Welcome</h1>
  <button class="btn" onclick="openPopup()">Go to Menu</button>
</div>

<div class="popup" id="popup">
  <div class="popup-box">
    <h3>Continue to Login?</h3>
    <button class="login-btn" onclick="goLogin()">Login</button>
    <button class="cancel-btn" onclick="closePopup()">Cancel</button>
  </div>
</div>

<script>
  function openPopup() {
    const popup = document.getElementById("popup");
    popup.style.display = "flex";
  }

  function closePopup() {
    const popup = document.getElementById("popup");
    popup.style.display = "none";
  }

  function goLogin() {
    window.location.href = "login.html";
  }
</script>

</body>
</html>
